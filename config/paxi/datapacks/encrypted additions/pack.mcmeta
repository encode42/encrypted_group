{
	"pack": {
		"pack_format": 48,
		"description": "Various crafting tweaks and additions"
	},
	"filter": {
        "block": [
            {
                "namespace": "^toxony$",
                "path": "^structure/(hunter_watchtower|old_adventure_guild|old_experiment_house).nbt$"
            },
            {
                "namespace": "^relicsofrain$",
                "path": "^structure/(remnants|ruins)/.*$"
            },
            {
                "namespace": "^relicsofrain$",
                "path": "^loot_table/(ancient_remnants|spaceship_ruins).json$"
            }
        ]
    }
}
