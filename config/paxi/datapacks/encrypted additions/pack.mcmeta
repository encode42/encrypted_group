{
	"pack": {
		"pack_format": 48,
		"description": "Various crafting tweaks and additions"
	},
	"filter": {
        "block": [
            {
                "namespace": "^toxony$",
                "path": "^structure/(hunter_watchtower|old_adventure_guild|old_experiment_house).*$"
            },
            {
                "namespace": "^relicsofrain$",
                "path": "^structure/.*$"
            },
            {
                "namespace": "^minecraft$",
                "path": "^structure/woodland_mansion/.*$"
            }
        ]
    }
}
